@keyframes slideInDown {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideInUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes shimmer {
  0% { box-shadow: 0 6px 18px rgba(0,52,163,0.18); }
  50% { box-shadow: 0 6px 25px rgba(0,82,163,0.25); }
  100% { box-shadow: 0 6px 18px rgba(0,52,163,0.18); }
}

@keyframes buttonHover {
  0% { transform: translateY(0); box-shadow: 0 4px 12px rgba(0,52,163,0.2); }
  50% { transform: translateY(-3px); }
  100% { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,102,204,0.3); }
}

@keyframes buttonPress {
  0% { transform: translateY(-3px); }
  100% { transform: translateY(0); }
}

@keyframes glow {
  0% { box-shadow: 0 4px 12px rgba(0,52,163,0.2), 0 0 10px rgba(0,82,163,0); }
  50% { box-shadow: 0 8px 24px rgba(0,102,204,0.3), 0 0 20px rgba(0,102,204,0.4); }
  100% { box-shadow: 0 4px 12px rgba(0,52,163,0.2), 0 0 10px rgba(0,82,163,0); }
}

@keyframes expandFromMiddle {
  0% { transform: scaleX(0); opacity: 0; }
  50% { opacity: 1; }
  100% { transform: scaleX(1); opacity: 1; }
}

@keyframes fadeInView {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeOutView {
  from {
