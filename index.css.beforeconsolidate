    background: rgba(255,255,255,0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.neighborhood-map-section a:hover::before {
    width: 300px;
    height: 300px;
}

.neighborhood-map-section a:hover {
    animation: buttonHover 0.4s ease-out forwards;
    color: white;
}

.neighborhood-map-section a:active {
    animation: buttonPress 0.2s ease-out forwards;
}
