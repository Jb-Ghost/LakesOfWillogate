/* Main content */
main {
    padding: 0 0 60px 0;
    background: 
        url("data:image/svg+xml,%3Csvg width='100' height='60' viewBox='0 0 100 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 30Q25 10 50 30T100 30' stroke='rgba(0,52,163,0.1)' stroke-width='2' fill='none'/%3E%3Cpath d='M0 40Q25 20 50 40T100 40' stroke='rgba(0,52,163,0.08)' stroke-width='1.5' fill='none'/%3E%3Cpath d='M0 20Q25 5 50 20T100 20' stroke='rgba(0,52,163,0.06)' stroke-width='1' fill='none'/%3E%3C/svg%3E"),
        linear-gradient(135deg, #f5ede3 0%, #f9f3eb 50%, #fdf8f4 100%);
    background-size: 100px 60px;
}

/* Hero Section */
.hero-section {
    background: 
        linear-gradient(rgba(68, 136, 188, 0.3), rgba(68, 136, 188, 0.3)),
        url(Lake.jpg);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: scroll;
    color: white;
    padding: 40px 40px;
    text-align: center;
    animation: fadeInHero 1.2s ease-out, shine 3s ease-in-out infinite;
    position: relative;
    overflow: hidden;
}

.hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    animation: heroShimmer 3s ease-in-out infinite;
}

@keyframes heroShimmer {
    0% { left: -100%; }
    50%, 100% { left: 100%; }
}

.eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    margin: 0 0 10px 0;
    font-weight: 700;
    opacity: 0;
    animation: fadeInDown 0.8s ease-out 0.3s forwards;
}

.hero-section h1 {
    font-size: 56px;
    font-family: BungeeInline;
    margin: 0 0 20px 0;
    line-height: 1.2;
    letter-spacing: 0.5px;
    opacity: 0;
    animation: fadeInScale 0.8s ease-out 0.5s forwards;
}

@keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
}

.hero-section p {
    font-size: 22px;
    margin: 0 0 40px 0;
    opacity: 0;
    line-height: 1.4;
    animation: fadeIn 0.8s ease-out 0.7s forwards;
}

.hero-buttons {
    display: flex;
